# Copy only the entries you need and replace every placeholder. Never commit
# the real file or private keys.

# Required when applying the production Auth configuration with
# `supabase config push`; keep the Namecheap mailbox password out of Git.
MAPLOV_SMTP_PASSWORD=YOUR_NAMECHEAP_PRIVATE_EMAIL_PASSWORD

GOOGLE_PLAY_PACKAGE_NAME=ca.maplov.app
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"YOUR_PROJECT"}
GOOGLE_PUBSUB_AUDIENCE=https://YOUR_PROJECT_REF.supabase.co/functions/v1/store-subscription-events
GOOGLE_PUBSUB_SERVICE_ACCOUNT=play-billing-push@YOUR_PROJECT.iam.gserviceaccount.com

APPLE_BUNDLE_ID=ca.maplov.app
APPLE_APP_ID=YOUR_NUMERIC_APPLE_APP_ID
APPLE_IAP_ISSUER_ID=YOUR_APP_STORE_CONNECT_ISSUER_ID
APPLE_IAP_KEY_ID=YOUR_IN_APP_PURCHASE_KEY_ID
APPLE_IAP_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY\n-----END PRIVATE KEY-----
APPLE_ROOT_CERTIFICATES_BASE64=["BASE64_DER_APPLE_ROOT_CA"]
