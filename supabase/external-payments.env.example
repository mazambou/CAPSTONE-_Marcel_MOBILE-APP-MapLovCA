# Copy this file to an ignored local file such as:
# supabase/.env.external-payments
# Never commit real values.

# Keep false until every sandbox checklist item is complete.
EXTERNAL_CHECKOUT_ENABLED=false
EXTERNAL_CHECKOUT_ALLOWED_ORIGINS=https://maplov.ca,https://www.maplov.ca
EXTERNAL_CHECKOUT_SUCCESS_URL=https://maplov.ca/premium/external-return
EXTERNAL_CHECKOUT_CANCEL_URL=https://maplov.ca/premium/external-return
EXTERNAL_BILLING_RETURN_URL=https://maplov.ca/premium/subscription

# Stripe
STRIPE_SECRET_KEY=sk_test_REPLACE_ME
STRIPE_PUBLISHABLE_KEY=pk_test_REPLACE_ME
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME
# The 14 Price IDs are resolved server-side through their immutable MapLov
# lookup keys after an administrator runs sync-stripe-catalog.

# PayPal (false = sandbox)
PAYPAL_LIVE_MODE=false
PAYPAL_CLIENT_ID=REPLACE_ME
PAYPAL_CLIENT_SECRET=REPLACE_ME
PAYPAL_WEBHOOK_ID=REPLACE_ME
PAYPAL_PLUS_PLAN_ID=P-REPLACE_PLUS
PAYPAL_VIP_PLAN_ID=P-REPLACE_VIP

# Flutterwave. Confirm the recurring currency with Flutterwave for this
# merchant account; do not assume every account supports the same currencies.
FLUTTERWAVE_SECRET_KEY=FLWSECK_TEST-REPLACE_ME
FLUTTERWAVE_SECRET_HASH=REPLACE_WITH_A_LONG_RANDOM_VALUE
FLUTTERWAVE_CURRENCY=USD
FLUTTERWAVE_PLUS_PLAN_ID=REPLACE_PLUS
FLUTTERWAVE_VIP_PLAN_ID=REPLACE_VIP
FLUTTERWAVE_PLUS_AMOUNT_MINOR=1299
FLUTTERWAVE_VIP_AMOUNT_MINOR=1999
